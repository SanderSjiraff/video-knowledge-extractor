# Public template only. Never add real credentials here.
# Run commands from the repository root. Existing environment variables win.
USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# Remote API: set USE_OLLAMA=false and supply your own endpoint/key/model.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Empty unless supported. Qwen3.8 accepts low, medium, xhigh (not high).
LLM_REASONING_EFFORT=
# USD per million tokens. Set BOTH for custom models; 0 only for a free route.
LLM_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
LLM_MAX_OUTPUT_TOKENS=4096

# Estimate gate per run, not a hard billing cap or a lifetime budget.
SPENDING_LIMIT_USD=5.0
DRY_RUN_LIMIT=5
RATE_LIMIT_SECONDS=1.0

# On-screen text capture ('screen-text'): needs ffmpeg on PATH and an OCR
# engine installed separately (pip install easyocr  |  pip install paddleocr paddlepaddle).
OCR_ENGINE=easyocr
VISUAL_FRAME_INTERVAL=10
VISUAL_MAX_FRAMES=200

# Vision-model frame descriptions ('describe-frames'): local Ollama (free) or
# an OpenAI-compatible vision endpoint (VISION_API_URL, or LLM_API_URL if it
# accepts image content parts). Cost-capped at VISION_MAX_FRAMES per video.
VISION_PROVIDER=ollama
VISION_MODEL=llava
VISION_MAX_FRAMES=6
# VISION_API_URL=

# Semantic search ('embed' + 'search-semantic'): local Ollama (free) or an
# OpenAI-compatible /embeddings endpoint. Separate small model; does not add
# cost to the analysis pipeline.
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# EMBED_API_URL=
# EMBED_API_KEY=
EMBED_CHUNK_CHARS=15000

# Cookies file (Netscape format, exported from your browser) for Instagram /
# TikTok / age-restricted YouTube. Leave unset if you don't need it.
# YOUTUBE_COOKIES_FILE=

# Platform: API server (python src/cli.py api | platform).
API_HOST=127.0.0.1
API_PORT=8000

# Platform: Telegram send-channel (python src/cli.py bot).
# Create a bot with @BotFather. Leave token empty to disable the bot.
# Find your numeric user id by messaging @userinfobot.
# With an EMPTY allow-list the bot refuses everyone (safe default).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
