# LLM Configuration
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini

# Ollama (local, no-cost mode)
# Set USE_OLLAMA=true to use local Ollama instead of paid API
USE_OLLAMA=false
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# Cost Controls
# Maximum estimated cost in USD before requiring explicit approval
SPENDING_LIMIT_USD=5.00

# Processing
# Default number of videos to process in dry-run mode
DRY_RUN_LIMIT=5

# Rate Limiting (seconds between API calls)
RATE_LIMIT_SECONDS=1
